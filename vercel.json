{
  "functions": {
    "api/search.js": {
      "includeFiles": "data/records.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/ui/index.html"
    },
    {
      "source": "/ui/(.*)",
      "destination": "/ui/$1"
    }
  ]
}